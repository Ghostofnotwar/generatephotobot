# ── Telegram Bot ────────────────────────────────────────────────
# Токен бота, полученный у @BotFather. Обязателен.
BOT_TOKEN=123456789:AAExampleBotTokenExampleBotTokenExampleBotToken

# HTTPS-адрес Mini App (статический хостинг: Cloudflare Pages, Vercel, GitHub Pages…).
# Обязателен. Должен начинаться с https://.
WEBAPP_URL=https://your-miniapp.example.com

# ── Cloudflare Workers AI (FLUX.1 Schnell) ─────────────────────
# Account ID (колонка в панели Cloudflare) и API-токен с правом Workers AI.
# Токен нужен не «deploy-only», а с разрешением на использование Workers AI.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ── Параметры генерации ───────────────────────────────────────
# Количество diffusion-шагов FLUX.1 Schnell (1–8, по умолчанию 4).
FLUX_STEPS=4
# Таймаут HTTP-запроса к Cloudflare в секундах.
HTTP_TIMEOUT=120
# Максимальная длина промпта в знаках (Cloudflare ограничена 2048).
MAX_PROMPT_CHARS=2000

# ── Пути ───────────────────────────────────────────────────────
# Путь к canonical-файлу промптов (по умолчанию <корень>/prompts.json).
# PROMPTS_PATH=./prompts.json

# ── Эксклюзивный доступ (опционально) ─────────────────────────
# Если задан ID, бот будет отвечать только этому пользователю.
# Если пустым — бот доступен всем.
ALLOWED_USER_ID=

# ── Опциональный прямой HTTP API бота (необязательно) ─────────
# Если задан BOT_API_HOST, бот поднимает HTTP-сервер и обрабатывает
# POST /generate напрямую (Mini App может использовать его вместо sendData).
# BOT_API_HOST=0.0.0.0
BOT_API_HOST=
BOT_API_PORT=8080
# Origin Mini App для CORS, например https://your-miniapp.example.com
# BOT_API_CORS_ORIGIN=https://your-miniapp.example.com
